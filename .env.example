# CRC Environment Variables
# Copy this file to .env and fill in the values.
# Alternatively, copy core/config.local.example.php to core/config.local.php.
# Never commit .env or config.local.php.

# Database
DB_HOST=localhost
DB_NAME=your-database-name
DB_USER=your-database-user
DB_PASS=your-database-password

# Diary AI Settings
DIARY_OPENAI_API_KEY=your-openai-api-key-here

# AI SmartBible Settings
SMARTBIBLE_OPENAI_API_KEY=your-openai-api-key-here

# General AI Settings (for Bible explain)
AI_API_KEY=your-ai-api-key-here

# Web Push (generate with: php _scripts/generate_vapid.php)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Application Settings
CRC_ENV=production
APP_URL=https://crc.org.za
